<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- 功能：继承统一的 Java、依赖和构建版本，生成独立的商品目录服务。 -->
    <parent>
        <groupId>edu.cs6510</groupId>
        <artifactId>service-based-server</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>catalog-service</artifactId>
    <name>Catalog Service</name>
    <dependencies>
        <!-- 功能：复用数据库实体、Repository、缓存和 API 数据结构。 -->
        <dependency>
            <groupId>edu.cs6510</groupId>
            <artifactId>shared-persistence</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- 功能：打包为可直接使用 java -jar 启动的 Spring Boot JAR。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
