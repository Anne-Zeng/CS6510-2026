# 复制为 .env，填入四个账号的密码。此文件仅按文本解析，不执行 shell。
# 数据库和角色需预先创建；启动脚本只建表/升级、为空表准备演示数据。
CATALOG_DB_URL=jdbc:postgresql://localhost:5432/event_catalog_db
CATALOG_DB_USER=event_catalog_user
CATALOG_DB_PASSWORD='replace-with-catalog-password'
CHECKOUT_DB_URL=jdbc:postgresql://localhost:5432/event_checkout_db
CHECKOUT_DB_USER=event_checkout_user
CHECKOUT_DB_PASSWORD='replace-with-checkout-password'
INVENTORY_DB_URL=jdbc:postgresql://localhost:5432/event_inventory_db
INVENTORY_DB_USER=event_inventory_user
INVENTORY_DB_PASSWORD='replace-with-inventory-password'
ANALYTICS_DB_URL=jdbc:postgresql://localhost:5432/event_analytics_db
ANALYTICS_DB_USER=event_analytics_user
ANALYTICS_DB_PASSWORD='replace-with-analytics-password'
# 可选：每个 JVM 的内存配置
EVENT_JAVA_OPTS='-Xms64m -Xmx256m -XX:TieredStopAtLevel=1'
# 库存等待不占数据库连接；该上限与 Inventory 本地数据库并发上限分别控制。
CHECKOUT_INVENTORY_MAX_IN_FLIGHT=64
INVENTORY_MAX_IN_FLIGHT=8
# Coalesce already queued scans from up to 64 distinct baskets in one durable SQL.
# Queue capacity is 512; batching adds no intentional collection delay.
CHECKOUT_SCAN_BATCHING_ENABLED=true
# Diagnostic batch size/write timings, disabled in normal runs.
CHECKOUT_SCAN_PERFORMANCE_LOG=false

# Kafka runs separately. Compose uses 9092; scripts/kafka-local.py uses 19092.
# For the native helper, change the address below to 127.0.0.1:19092.
# This file overrides terminal environment variables when using run.sh.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC_PREFIX=selfcheckout
KAFKA_REQUEST_TIMEOUT_MS=8000
KAFKA_TOPIC_PARTITIONS=1
# Network poller counts; business handlers execute separately on virtual threads.
KAFKA_CHECKOUT_CONCURRENCY=1
KAFKA_INVENTORY_CONCURRENCY=1
KAFKA_CATALOG_CONCURRENCY=1
KAFKA_ANALYTICS_CONCURRENCY=1
# fetch.min.bytes is fixed at 1: available records return without waiting 500 ms.
KAFKA_FETCH_MAX_WAIT_MS=500
KAFKA_EVENT_FETCH_MAX_WAIT_MS=500
KAFKA_COMMAND_POLL_MS=100
# Opaque business JSON plus Kafka correlation headers; readers accept old JSON envelopes.
# For a staged upgrade, keep false until all command consumers have been upgraded.
KAFKA_HEADER_ENVELOPES=true
# Opt-in cumulative stage timings; leave off for normal performance runs.
KAFKA_PERFORMANCE_LOG=false
ANALYTICS_QUERY_CATCH_UP_MS=6000
