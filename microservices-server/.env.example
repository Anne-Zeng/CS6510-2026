# 复制为 .env，填入四个账号的密码。此文件仅按文本解析，不执行 shell。
# 数据库和角色需预先创建；启动脚本只建表/升级、为空表准备演示数据。
CATALOG_DB_URL=jdbc:postgresql://localhost:5432/catalog_db
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD='replace-with-catalog-password'
CHECKOUT_DB_URL=jdbc:postgresql://localhost:5432/checkout_db
CHECKOUT_DB_USER=checkout_user
CHECKOUT_DB_PASSWORD='replace-with-checkout-password'
INVENTORY_DB_URL=jdbc:postgresql://localhost:5432/inventory_db
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD='replace-with-inventory-password'
ANALYTICS_DB_URL=jdbc:postgresql://localhost:5432/analytics_db
ANALYTICS_DB_USER=analytics_user
ANALYTICS_DB_PASSWORD='replace-with-analytics-password'
# 可选：每个 JVM 的内存配置
MICROSERVICES_JAVA_OPTS='-Xms32m -Xmx192m -XX:TieredStopAtLevel=1'
# 可选：库存协调的有界并发，默认与 Inventory 的 8 个数据库连接配合。
CHECKOUT_INVENTORY_MAX_IN_FLIGHT=8
INVENTORY_MAX_IN_FLIGHT=8
